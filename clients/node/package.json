{
  "name": "opas-client",
  "version": "0.1.4",
  "description": "Node.js client for the opas model router: routing decisions, prices, and helpers for using the OpenAI and Anthropic SDKs through opas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panuhorsmalahti/opas.git",
    "directory": "clients/node"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "openapi-typescript ../../docs/openapi.json -o src/schema.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"test/*.test.ts\"",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@types/node": "26.6.6",
    "openai": "7.57.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
